{
  "name": "mnx-lab",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "workspaces": [
    "converters/*",
    "experiments/performance-listening/bench"
  ],
  "files": [
    "dist/lib",
    "public/smufl",
    "public/samples"
  ],
  "exports": {
    ".": "./dist/lib/index.js",
    "./model": "./dist/lib/model.js",
    "./engine": "./dist/lib/engine.js",
    "./audio": "./dist/lib/audio.js",
    "./elements": "./dist/lib/elements.js",
    "./smufl/*": "./public/smufl/*",
    "./samples/*": "./public/samples/*"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=DEP0040 vite",
    "dev:login": "node tools/library-local-auth.mjs --seed",
    "dev:port": "node tools/dev-port.mjs",
    "worktree:retire": "node tools/worktree-retire.mjs",
    "gate": "node tools/gate.mjs",
    "build": "npm run compile-validator && npm run check:boundaries && tsc && tsc -p worker && npm run typecheck:harness && vite build",
    "build:site": "vite build",
    "build:lib": "vite build -c vite.lib.config.ts",
    "build:embed": "vite build -c vite.embed.config.ts",
    "smoke:lib": "node harness/verify/run-smokes.mjs lib",
    "smoke:embed": "node harness/verify/run-smokes.mjs embed",
    "smoke:csp": "node harness/verify/run-smokes.mjs csp",
    "smoke:selection": "node harness/verify/run-smokes.mjs selection",
    "smoke:inspector": "node harness/verify/run-smokes.mjs inspector",
    "smoke:focus": "node harness/verify/run-smokes.mjs focus",
    "smoke:sync-bar": "node harness/verify/run-smokes.mjs sync-bar",
    "smoke:sync-rederive": "node harness/verify/run-smokes.mjs sync-rederive",
    "smoke:piece-create": "node harness/verify/run-smokes.mjs piece-create",
    "smoke:save-pipeline": "node harness/verify/run-smokes.mjs save-pipeline",
    "smoke:piece-lifecycle": "node harness/verify/run-smokes.mjs piece-lifecycle",
    "smoke:studio-editor": "node harness/verify/run-smokes.mjs studio-editor",
    "smoke:play-only": "node harness/verify/run-smokes.mjs play-only",
    "smoke:workbench-editor": "node harness/verify/run-smokes.mjs workbench-editor",
    "dev:embed-app": "npm run build:embed && node harness/verify/serve-embed-app.mjs",
    "preview": "vite preview",
    "compile-validator": "node spec/tools/compile-validator.mjs",
    "check:scenarios": "node harness/verify/check-scenarios.mjs",
    "typecheck:harness": "node tools/typecheck-harness.mjs",
    "check:boundaries": "depcruise src worker harness apps converters experiments --config .dependency-cruiser.cjs",
    "sync:spec": "node spec/tools/sync-spec-examples.mjs",
    "sync:musicxml-comparisons": "node spec/tools/sync-musicxml-comparisons.mjs",
    "push:proposal": "node spec/tools/push-proposal.mjs",
    "update:primitives": "UPDATE_PRIMITIVES=1 vitest run harness/conformance/primitives.test.ts harness/conformance/performance-goldens.test.ts harness/conformance/unrolled-goldens.test.ts",
    "update:musicxml-oracle": "UPDATE_MUSICXML_ORACLE=1 vitest run harness/conformance/musicxml-oracle.test.ts",
    "update:converter-matrix": "UPDATE_CONVERTER_MATRIX=1 vitest run harness/conformance/converter-matrix.test.ts",
    "update:edit-traces": "UPDATE_EDIT_TRACES=1 vitest run harness/conformance/edit-traces.test.ts",
    "update:roundtrip-register": "UPDATE_ROUNDTRIP_REGISTER=1 vitest run harness/conformance/roundtrip-register.test.ts",
    "report:roundtrip-library": "vite-node --config vitest.config.ts harness/verify/roundtrip-library.ts --",
    "sweep:destruct": "UPDATE_DESTRUCT_SWEEP=1 vitest run harness/conformance/destruct-sweep.test.ts",
    "sweep:construct": "UPDATE_CONSTRUCT_COVERAGE=1 vitest run harness/conformance/construct-traces.test.ts",
    "verify:scenarios": "node harness/verify/verify-scenarios.mjs",
    "update:icons": "node tools/make-icons.mjs",
    "update:roster": "UPDATE_ROSTER=1 vitest run harness/conformance/roster.test.ts",
    "refresh:catalog": "REFRESH_CATALOG=1 UPDATE_ROSTER=1 vitest run harness/conformance/roster.test.ts",
    "test": "vitest run",
    "ingest:library": "node tools/library-ingest.mjs",
    "defects:library": "node tools/library-defects.mjs",
    "deploy": "npm run build && wrangler deploy",
    "update:traversal": "UPDATE_TRAVERSAL=1 vitest run harness/conformance/traversal.test.ts",
    "smoke:audio": "node harness/verify/run-smokes.mjs audio",
    "smoke:player": "node harness/verify/run-smokes.mjs player",
    "capture:midi-oracle": "node harness/verify/capture-midi-oracle.mjs",
    "check:midi-oracle-live": "node harness/verify/capture-midi-oracle.mjs --check",
    "update:midi-oracle": "UPDATE_MIDI_ORACLE=1 vitest run harness/conformance/midi-oracle.test.ts",
    "smoke:unrolled": "node harness/verify/run-smokes.mjs unrolled",
    "smoke": "node harness/verify/run-smokes.mjs",
    "sync:musicxml-suite": "python3 harness/tools/sync-musicxml-suite.py",
    "update:musicxml-suite": "UPDATE_MUSICXML_SUITE=1 vitest run harness/conformance/musicxml-suite.test.ts",
    "check:musicxml-suite": "vitest run harness/conformance/musicxml-suite.test.ts",
    "setup:musicxml-oracle": "uv sync --project harness/musicxml-oracle --locked",
    "capture:musicxml-oracle": "CAPTURE_MUSICXML_ORACLE=1 vitest run harness/conformance/musicxml-independent.test.ts",
    "check:musicxml-oracle-live": "CHECK_MUSICXML_ORACLE=1 vitest run harness/conformance/musicxml-independent.test.ts",
    "update:musicxml-independent": "UPDATE_MUSICXML_INDEPENDENT=1 vitest run harness/conformance/musicxml-independent.test.ts"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@lit/context": "^1.1.3",
    "hono": "^4.12.25",
    "jose": "^6.2.12",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.7",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^26.1.2",
    "ajv": "^8.20.0",
    "dependency-cruiser": "^17.0.1",
    "typescript": "^5.4.5",
    "vite": "^8.0.14",
    "vitest": "^4.1.8",
    "wrangler": "^4.131.0"
  }
}
