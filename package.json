{
  "name": "mnx-lab",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "workspaces": [
    "converters/*"
  ],
  "files": [
    "dist/lib",
    "public/smufl"
  ],
  "exports": {
    ".": "./dist/lib/index.js",
    "./model": "./dist/lib/model.js",
    "./engine": "./dist/lib/engine.js",
    "./audio": "./dist/lib/audio.js",
    "./elements": "./dist/lib/elements.js",
    "./smufl/*": "./public/smufl/*"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=DEP0040 vite",
    "build": "npm run compile-validator && npm run check:boundaries && tsc && tsc -p worker && vite build",
    "build:lib": "vite build -c vite.lib.config.ts",
    "build:embed": "vite build -c vite.embed.config.ts",
    "smoke:lib": "npm run build:lib && node harness/verify/lib-smoke.mjs",
    "smoke:embed": "npm run build:embed && node harness/verify/embed-smoke.mjs",
    "smoke:csp": "npm run build && node harness/verify/csp-smoke.mjs",
    "smoke:selection": "npm run build && node harness/verify/selection-smoke.mjs",
    "smoke:inspector": "npm run build && node harness/verify/inspector-smoke.mjs",
    "smoke:focus": "npm run build && node harness/verify/focus-mode-smoke.mjs",
    "dev:embed-app": "npm run build:embed && node harness/verify/serve-embed-app.mjs",
    "preview": "vite preview",
    "compile-validator": "node spec/tools/compile-validator.mjs",
    "check:scenarios": "node harness/verify/check-scenarios.mjs",
    "check:boundaries": "depcruise src worker harness --config .dependency-cruiser.cjs",
    "sync:spec": "node spec/tools/sync-spec-examples.mjs",
    "update:primitives": "UPDATE_PRIMITIVES=1 vitest run harness/conformance/primitives.test.ts",
    "update:edit-traces": "UPDATE_EDIT_TRACES=1 vitest run harness/conformance/edit-traces.test.ts",
    "sweep:destruct": "UPDATE_DESTRUCT_SWEEP=1 vitest run harness/conformance/destruct-sweep.test.ts",
    "sweep:construct": "UPDATE_CONSTRUCT_COVERAGE=1 vitest run harness/conformance/construct-traces.test.ts",
    "verify:scenarios": "node harness/verify/verify-scenarios.mjs",
    "update:roster": "UPDATE_ROSTER=1 vitest run harness/conformance/roster.test.ts",
    "refresh:catalog": "REFRESH_CATALOG=1 UPDATE_ROSTER=1 vitest run harness/conformance/roster.test.ts",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.7.0",
    "@coderline/alphatab": "^1.8.4",
    "@fontsource/archivo": "^5.3.0",
    "@lit/context": "^1.1.3",
    "hono": "^4.12.25",
    "idb-keyval": "^6.2.4",
    "lit": "^3.3.3",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.40.1",
    "@cloudflare/workers-types": "^4.20260609.1",
    "@types/node": "^26.1.2",
    "ajv": "^8.20.0",
    "dependency-cruiser": "^17.0.1",
    "typescript": "^5.4.5",
    "vite": "^8.0.14",
    "vitest": "^4.1.8",
    "wrangler": "^4.99.0"
  }
}
