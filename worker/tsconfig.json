{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["./**/*.ts", "./**/*.mts", "../server/prompts/*.js"]
}
