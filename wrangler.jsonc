{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mnx-lab",
  "main": "worker/index.ts",
  "account_id": "e95cec11beeb0167dcd9f5c034f564ec",
  // Studio storage: local in dev; tools/bootstrap-storage.mjs records the real D1 UUID.
  "d1_databases": [
    {
      "binding": "LIBRARY_DB",
      "database_name": "mnx-studio-library",
      "database_id": "2e76025c-80d7-40b8-a2dd-c80f051b1867",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "LIBRARY_BUCKET",
      "bucket_name": "mnx-studio-library",
      "remote": false
    }
  ],
  "vars": {
    "LIBRARY_ACCESS_ISSUER": "https://mnx-labs-team.cloudflareaccess.com",
    "LIBRARY_ACCESS_AUD": "",
    "LIBRARY_INGEST_AUD": "",
    "LIBRARY_INGEST_CLIENT_ID": ""
  },
  "compatibility_date": "2026-06-01",
  // Static assets (the Vite client build) are served in front of the Worker:
  // any request not matching an asset file invokes the Worker (/api/*), and
  // unknown non-asset paths fall back to index.html (SPA mode).
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "mnx-lab.totai.uk",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
